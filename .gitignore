# ============================================================================
# Unreal Engine
# ============================================================================
# Build artifacts and generated content — never committed.
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/
Script/

# Project files generated by UBT (UnrealBuildTool)
*.sln
*.suo
*.opensdf
*.opendb
*.sdf
*.VC.db
*.VC.VC.opendb
*.xcodeproj/
*.xcworkspace/

# UE generated source
*.generated.h
*.generated.cpp

# Plugin build outputs (defensive — covered by Binaries/Intermediate above)
Plugins/**/Binaries/
Plugins/**/Intermediate/
Plugins/**/Saved/

# Crash dumps and logs
*.dmp
*.log

# ============================================================================
# IDE / Editor
# ============================================================================
# Visual Studio
.vs/
*.user
*.userosscache
*.suo
*.ncrunchproject
*.ncrunchsolution
_NCrunch_*

# Rider
.idea/

# VS Code — keep workspace settings, ignore local state
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

# Visual Studio Code workspace
*.code-workspace

# ============================================================================
# OS
# ============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ============================================================================
# Blender
# ============================================================================
# Auto-save backups — keep the .blend, drop the autosaves
*.blend1
*.blend2
*.blend3
*.blend@

# ============================================================================
# Misc
# ============================================================================
# Local environment overrides
.env
.env.local

# Archive files (case-by-case — uncomment if you ship distributables)
# *.zip
# *.7z
