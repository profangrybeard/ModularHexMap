# ============================================================================
# Line endings
# ============================================================================
# Default: let git pick, normalize to LF on commit.
* text=auto eol=lf

# Force LF for code (Unreal sources, build scripts, configs)
*.cpp text eol=lf
*.h   text eol=lf
*.cs  text eol=lf
*.ini text eol=lf
*.md  text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.py   text eol=lf
*.sh   text eol=lf

# Force CRLF for Windows-specific scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Mark Unreal generated/manifest text files explicitly
*.uproject text eol=lf
*.uplugin  text eol=lf
*.Target.cs text eol=lf
*.Build.cs  text eol=lf

# ============================================================================
# Git LFS — binary asset tracking
# ============================================================================
# Unreal binary content
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap   filter=lfs diff=lfs merge=lfs -text

